# Database configuration
DB_URL=jdbc:mysql://localhost:3306/cyber_incident_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&autoReconnect=true
DB_USERNAME=root
DB_PASSWORD=

# JWT configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Evidence storage
STORAGE_UPLOAD_DIR=./uploads/evidence

# Demo seed account passwords
CIRS_ADMIN_PASSWORD=change-this-admin-password
CIRS_INVESTIGATOR_PASSWORD=change-this-investigator-password
CIRS_USER_PASSWORD=change-this-user-password